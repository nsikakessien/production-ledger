{
  "name": "production-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Double-entry lending ledger: term loans, invoice financing, idempotent payments, reversals, period close.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:docker": "docker compose --profile test run --rm --build test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
